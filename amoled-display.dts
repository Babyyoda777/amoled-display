/dts-v1/;
/plugin/;
/ {
	compatible = "brcm,bcm2712", "raspberrypi,5-compute-module", "raspberrypi,5-model-b";

	fragment@0 {
		target = <&dsi0>;
		__overlay__{
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;
			port {
				dsi_out_port:endpoint {
					remote-endpoint = <&panel_dsi_port>;
				};
			};

			pibrick:pibrick@0 {
				compatible    = "pibrick,amoled";
				status        = "okay";
				reg           = <0>;
				reset-gpios   = <&gpio 47 1>;   // Dummy GPIO , Unused
				rotation      = <0>;
				port {
					panel_dsi_port: endpoint {
						remote-endpoint = <&dsi_out_port>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			pibrick_pins: pibrick_pins {
				brcm,pins = <47>;
				brcm,function = <1>; // out
				brcm,pull = <1>; // off
			};
		};
	};

	fragment@2 {
		target = <&i2c0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			hynitron@5A {
				compatible = "hyn,66xx";
				reg = <0x5A>;

				interrupt-parent = <&gpio>;
				interrupts = <4 2>;
				reset-gpio = <&gpio 17 1>;
				irq-gpio = <&gpio 4 2>; 
				
				panel = <&pibrick>;

				max-touch-number = <5>;
				display-coords = <0 0 1080 1240>;
				pos-swap = <1>;
				posx-reverse = <0>;
				posy-reverse = <0>;
			};
		};
	};
	
};
